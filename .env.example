GEMINI_API_KEY=your-gemini-key-here

# Optional overrides. JUDGE_MODEL / REFLECTION_MODEL take a judge name from
# config.JUDGES (gemini, gpt-oss, dtu, azure, jev) or any LiteLLM model string.
# JUDGE_MODEL=gemini
# REFLECTION_MODEL=gemini/gemini-flash-latest
# NUM_THREADS=4
# NUM_RETRIES=8        # retries with backoff on 429 rate limits
# CACHE=false          # true = reuse dspy's local cache for identical calls

# gpt-oss-safeguard (placeholder, pick one provider)
# GPT_OSS_MODEL=groq/openai/gpt-oss-safeguard-20b
# GROQ_API_KEY=your-groq-key-here
# GPT_OSS_MODEL=openrouter/openai/gpt-oss-safeguard-20b
# OPENROUTER_API_KEY=your-openrouter-key-here

# Self-hosted model on the DTU GPU (placeholder, OpenAI-compatible server)
# DTU_MODEL=hosted_vllm/your-model-name
# DTU_API_BASE=http://your-dtu-host:8000/v1
# DTU_API_KEY=only-if-the-server-needs-one

# Azure OpenAI (placeholder)
# AZURE_MODEL=azure/your-deployment-name
# AZURE_API_KEY=your-azure-key-here
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-10-21

# TypeSafe AI Jev
# TYPESAFE_API_KEY=your-typesafe-key-here
